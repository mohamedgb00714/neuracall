# ============================================================================
# NeuraCall environment reference (COMMITTED — placeholders only)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Only ASSEMBLYAI_API_KEY is required. Everything else has a working default,
# and any value still containing "replace-me" is treated as unset by
# `@neuracall/config` — so an unedited copy of this file behaves exactly like
# an empty one rather than sending a literal placeholder to a provider.
#
# Loading order: `loadEnv()` never overrides a variable already exported in
# the shell, so `ASSEMBLYAI_REGION=eu npm run ...` wins over the file.
# The desktop app searches for `.env` in the working directory, then
# `apps/desktop/`, then the repo root, then Electron's userData folder.
# ============================================================================

# --- AssemblyAI (Speech-to-Text) --------------------------------------------
# Create/rotate a key at https://www.assemblyai.com/dashboard/api-keys
# This is the raw key — no "Bearer" prefix (config rejects one at startup,
# because otherwise the failure surfaces as an opaque WebSocket 1008 mid-call).
# Read only in the Electron main process / Node scripts; it never reaches the
# renderer. Required: the runtime refuses to start without it.
ASSEMBLYAI_API_KEY=replace-me

# Region / data residency: "us", "eu" or "edge". Unset or blank => "edge".
# Selects the REST host, the realtime host and the token URL all at once.
#   us   -> api.assemblyai.com     / streaming.us.assemblyai.com
#   eu   -> api.eu.assemblyai.com  / streaming.eu.assemblyai.com
#   edge -> api.assemblyai.com     / streaming.assemblyai.com  (geo-routed)
# Any other value throws at startup rather than silently routing elsewhere.
ASSEMBLYAI_REGION=us

# Realtime speech model. Defaults to universal-3-5-pro when unset.
# Realtime uses the SINGULAR `speech_model` string; the pre-recorded API uses
# a plural `speech_models` array with a different default — see
# docs/DECISIONS.md §1 before changing this.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# --- AI agent brain (LLM for replies) ---------------------------------------
# Read into `config.llm`. The agent's `OpenAiCompatibleLlmClient` speaks the
# OpenAI /chat/completions shape and defaults to OpenRouter
# (https://openrouter.ai/api/v1), which covers Anthropic, OpenAI, Google and
# the rest behind one key. There is no LLM base-URL variable yet — a different
# provider root is passed in code as `baseUrl`.
# Leave as-is and the agent simply has no brain configured.
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# --- TTS provider -----------------------------------------------------------
# Read into `config.tts`. NOTE: no concrete TTS client is implemented yet —
# the agent falls back to `SilentTts`, which produces the right *duration* of
# silence so call pacing is realistic while the far end hears nothing.
# These exist so a provider can be wired without a config change.
TTS_API_KEY=replace-me
TTS_MODEL=replace-me

# --- Host tooling -----------------------------------------------------------
# Override the adb binary used by scripts/adb-setup.sh and scripts/adbtool.sh.
# Unset means "whatever `adb` resolves to on PATH". scrcpy is always taken
# from PATH and has no override.
# ADB=/opt/platform-tools/adb

# --- Desktop app (development only) -----------------------------------------
# When set (and NODE_ENV is not "production") the Electron main process loads
# the renderer from this URL instead of the built dist/index.html. Normally set
# inline on the launch command rather than in .env.
# VITE_DEV_SERVER_URL=http://localhost:5173
# NODE_ENV=development

# NOT a NeuraCall variable, but the one that breaks launches: some editor
# terminals (VS Code) export ELECTRON_RUN_AS_NODE=1, which makes the Electron
# binary behave as plain Node and no window opens. Launch Electron with
# `env -u ELECTRON_RUN_AS_NODE ...` — see docs/RUNBOOK.md.

# --- Reserved (declared, not yet read by any code) --------------------------
# WhatsApp call *detection* is done over adb (foreground package + UI dump) and
# needs no credentials. This is a placeholder for a future messaging bridge; no
# package reads it today.
WHATSAPP_TOKEN=replace-me
