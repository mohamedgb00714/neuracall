# ============================================================================
# NeuraCall environment reference (COMMITTED — placeholders only)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Only ASSEMBLYAI_API_KEY is required. Everything else has a working default,
# and any value still containing "replace-me" is treated as unset by
# `@neuracall/config` — so an unedited copy of this file behaves exactly like
# an empty one rather than sending a literal placeholder to a provider.
#
# Loading order: `loadEnv()` never overrides a variable already exported in
# the shell, so `ASSEMBLYAI_REGION=eu npm run ...` wins over the file.
# The desktop app searches for `.env` in the working directory, then
# `apps/desktop/`, then the repo root, then Electron's userData folder.
# ============================================================================

# --- AssemblyAI (Speech-to-Text) --------------------------------------------
# Create/rotate a key at https://www.assemblyai.com/dashboard/api-keys
# This is the raw key — no "Bearer" prefix (config rejects one at startup,
# because otherwise the failure surfaces as an opaque WebSocket 1008 mid-call).
# Read only in the Electron main process / Node scripts; it never reaches the
# renderer. Required: the runtime refuses to start without it.
ASSEMBLYAI_API_KEY=replace-me

# Region / data residency: "us", "eu" or "edge". Unset or blank => "edge".
# Selects the REST host, the realtime host and the token URL all at once.
#   us   -> api.assemblyai.com     / streaming.us.assemblyai.com
#   eu   -> api.eu.assemblyai.com  / streaming.eu.assemblyai.com
#   edge -> api.assemblyai.com     / streaming.assemblyai.com  (geo-routed)
# Any other value throws at startup rather than silently routing elsewhere.
ASSEMBLYAI_REGION=us

# Realtime speech model. Defaults to universal-3-5-pro when unset.
# Realtime uses the SINGULAR `speech_model` string; the pre-recorded API uses
# a plural `speech_models` array with a different default — see
# docs/DECISIONS.md §1 before changing this.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# Realtime latency/accuracy preset: min_latency | balanced | max_accuracy.
# `balanced` when unset. This is the primary turn-detection knob — prefer it
# over hand-tuning the silence thresholds.
# ASSEMBLYAI_MODE=balanced

# Comma-separated bias terms (max 100) pushed to the realtime stream: brand
# names, product names, anything the model would otherwise mishear.
# ASSEMBLYAI_KEYTERMS=NeuraCall,NeuraBiz,Annaba

# --- AssemblyAI Voice Agent (speech-to-speech) ------------------------------
# A second, separate AssemblyAI product from the streaming STT above: it does
# transcription, the LLM turn and the TTS in ONE WebSocket, on its own host
# family (agents.assemblyai.com). ASSEMBLYAI_REGION selects the agents host too
# (us/eu/edge -> agents.us. / agents.eu. / agents.), and the same
# ASSEMBLYAI_API_KEY authorises it — there is no second key.
# Residency note: "edge" is geo-routed for agents but resolves to the US cluster
# for transcription REST and the LLM gateway, so the default region can put the
# agent turn in a different jurisdiction from the rest of the call. Set
# ASSEMBLYAI_REGION=us or =eu explicitly if that matters; nothing fails loudly.
# Off unless VOICE_AGENT_ENABLED is set. Accepts 1/true/yes/on and 0/false/no/
# off; anything else throws at startup rather than quietly meaning "off".
# VOICE_AGENT_ENABLED=1

# Use a STORED agent (created with POST /v1/agents) instead of the inline config
# below. The two are MUTUALLY EXCLUSIVE — a session carrying both an agent id
# and inline fields is rejected — so when this is set, VOICE_AGENT_VOICE,
# _GREETING, _SYSTEM_PROMPT and _LLM_MODEL are ignored.
# Agents appear to be stored per region: create and use one under the same
# ASSEMBLYAI_REGION, or a perfectly valid id 404s for unrelated-looking reasons.
# Left as "replace-me" like every other operator-supplied id here: a plausible
# but fake uuid would pass config validation and only fail at session start.
# VOICE_AGENT_ID=replace-me

# The agent's voice. "alba" when unset. Exact voice_id values:
#   US English: alba eve george jane jean mary michael
#   UK English: anna charles paul vera
#   giovanni (it)  lola (es)  juergen (de)  rafael (pt)  estelle (fr)
# VOICE_AGENT_VOICE=alba

# The agent's opening line and persona. Distinct from NEURACALL_GREETING and
# NEURACALL_SYSTEM_PROMPT further down, which drive the separate STT+LLM+TTS
# pipeline; a call runs one path or the other, never both.
# VOICE_AGENT_GREETING=Thanks for calling NeuraBiz, how can I help?
# VOICE_AGENT_SYSTEM_PROMPT=You are the receptionist for NeuraBiz. Keep replies to one sentence.

# BYO-LLM model, served by the AssemblyAI LLM Gateway. Only takes effect on a
# STORED agent: an `llm` block sent inline is rejected with invalid_value
# ("define it on a stored agent via POST /v1/agents").
# This account is entitled to "qwen3.5-4b-32k-fast" ONLY — claude-*, gpt-*,
# gemini-* and the rest return HTTP 400 "does not have access to this model".
# VOICE_AGENT_LLM_MODEL=qwen3.5-4b-32k-fast

# There is deliberately NO sample-rate variable here. The Voice Agent API
# accepts 24000 Hz and nothing else, and a wrong rate does NOT fail validation:
# the session starts, then dies with a misleading
# {"code":"internal_error","message":"Internal service error"} and a 1011 close,
# which looks exactly like an AssemblyAI outage. NeuraCall captures at 16 kHz,
# so it resamples 16k->24k inbound and 24k->16k outbound instead.

# --- AI agent brain (LLM for replies) ---------------------------------------
# Read into `config.llm`. The agent's `OpenAiCompatibleLlmClient` speaks the
# OpenAI /chat/completions shape and defaults to OpenRouter
# (https://openrouter.ai/api/v1), which covers Anthropic, OpenAI, Google and
# the rest behind one key.
# Leave as-is and the agent transcribes but never replies.
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
# Any OpenAI-compatible root: OpenAI, Together, Groq, a local vLLM/Ollama.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- TTS provider (the agent's voice) ---------------------------------------
# Read into `config.tts`. Three providers are implemented; with none of them
# configured the agent falls back to `SilentTts`, which emits the right
# *duration* of silence so call pacing and the barge-in window stay realistic
# while the far end hears nothing.
TTS_API_KEY=replace-me
TTS_MODEL=replace-me

# Force a provider instead of auto-selecting: openai | elevenlabs | command | silent.
# Auto-selection: a key plus a model starting "eleven" -> ElevenLabs, else
# OpenAI-compatible; no key -> a local engine if one is on PATH; else silent.
# TTS_PROVIDER=openai

# Voice. The value space differs per provider — an OpenAI voice name
# ("alloy"), an ElevenLabs voice id, etc. It is deliberately NOT forwarded to
# the local engine, which speaks language codes; use TTS_COMMAND_VOICE for that.
# TTS_VOICE=alloy
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_SAMPLE_RATE=16000

# Local, zero-key speech. Auto-detected from PATH in this order:
# espeak-ng, espeak, piper, pico2wave. An unrecognised value is rejected
# rather than spawned, so a typo degrades to silence instead of failing every
# utterance of a live call.
# TTS_COMMAND=espeak-ng
# TTS_COMMAND_VOICE=en-gb
# PIPER_MODEL=/path/to/voice.onnx        # piper needs a model; without one it is skipped

# --- Autopilot / runtime ----------------------------------------------------
# All of these are also editable in the app's Settings page, which writes
# userData/settings.json — and the file wins over these values.

# The agent's persona and its opening line.
# NEURACALL_SYSTEM_PROMPT=You are the receptionist for NeuraBiz. Keep replies to one sentence.
# NEURACALL_GREETING=Thanks for calling NeuraBiz, how can I help?

# scrcpy --audio-source for far-end capture. "mic" (the default) records the
# phone's own microphone — YOUR side of a call, plus the room. To hear the
# caller you need a privileged source or the call on speakerphone.
# See docs/AUDIO-ABI.md before changing this.
# NEURACALL_AUDIO_SOURCE=mic

# Where the agent's voice is played so the phone can hear it — normally a
# Bluetooth HFP sink the phone treats as its headset
# (`pactl list short sinks` to find it). Unset means injection is OFF and the
# caller hears nothing, which is the safe default.
# NEURACALL_INJECT_SINK=bluez_output.AA_BB_CC_DD_EE_FF.1

# Watchdog limits. A call over maxCall, or silent for stall, is torn down so a
# wedged call cannot hold a phone forever.
# NEURACALL_MAX_CALL_MS=1800000
# NEURACALL_STALL_MS=120000

# Country calling code for caller IDs that arrive without one, so a national
# number still links to the CRM contact holding its E.164 form.
# NEURACALL_COUNTRY_CODE=213

# Loopback-only operator endpoint: GET /health and GET /metrics (Prometheus).
# Unset leaves it off.
# NEURACALL_HEALTH_PORT=9464

# --- Host tooling -----------------------------------------------------------
# Override the adb binary used by scripts/adb-setup.sh and scripts/adbtool.sh.
# Unset means "whatever `adb` resolves to on PATH". scrcpy is always taken
# from PATH and has no override.
# ADB=/opt/platform-tools/adb

# --- Desktop app (development only) -----------------------------------------
# When set (and NODE_ENV is not "production") the Electron main process loads
# the renderer from this URL instead of the built dist/index.html. Normally set
# inline on the launch command rather than in .env.
# VITE_DEV_SERVER_URL=http://localhost:5173
# NODE_ENV=development

# NOT a NeuraCall variable, but the one that breaks launches: some editor
# terminals (VS Code) export ELECTRON_RUN_AS_NODE=1, which makes the Electron
# binary behave as plain Node and no window opens. Launch Electron with
# `env -u ELECTRON_RUN_AS_NODE ...` — see docs/RUNBOOK.md.

# --- WhatsApp text bridge (optional) ----------------------------------------
# Call *detection* needs no credentials: it reads the device's audio mode and
# foreground package over adb, and works for WhatsApp, WhatsApp Business,
# Telegram, Signal and the rest (see docs/WHATSAPP.md).
#
# The rest of this section is the TEXT bridge (Cloud API), which needs a Meta
# app and a webhook URL Meta can reach. It is OFF until the first two are set:
# with none of them the app opens no port and binds no listener at all. Set
# some but not all and startup says so rather than half-working.
# WHATSAPP_ACCESS_TOKEN=replace-me        # permanent or system-user token
# WHATSAPP_PHONE_NUMBER_ID=replace-me     # the business number replies come from
# WHATSAPP_APP_SECRET=replace-me          # signs inbound deliveries; without it
#                                         # every inbound POST is refused
# WHATSAPP_VERIFY_TOKEN=replace-me        # the hub.challenge handshake

# Where the webhook listens. Bound to 127.0.0.1 on purpose: Meta reaches it
# through a tunnel or a reverse proxy that you choose and terminate TLS on, and
# publishing it to the LAN should never be a side effect of turning text on.
# Set WHATSAPP_WEBHOOK_HOST to 0.0.0.0 only behind such a proxy.
# WHATSAPP_WEBHOOK_PORT=8787
# WHATSAPP_WEBHOOK_HOST=127.0.0.1
# WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook   # must match the Meta app's callback URL

# Which brain answers a text. LLM_API_KEY/LLM_MODEL above win when they are
# set; otherwise text runs on the AssemblyAI LLM Gateway, on the key this app
# already requires — so it works with no LLM provider configured, which is the
# normal case now that the Voice Agent needs none. This account is entitled to
# exactly one gateway model; every other id returns HTTP 400.
# WHATSAPP_TEXT_MODEL=qwen3.5-4b-32k-fast
# WHATSAPP_TEXT_SYSTEM_PROMPT=You answer WhatsApp messages for Acme Ltd.

# The line these messages belong to. Defaults to whatsapp:<phone number id>;
# set it to a phone's adb serial to key the conversation to that handset.
# WHATSAPP_DEVICE_ID=replace-me

# --- Post-call analytics (optional, costs money) -----------------------------
# After a call ends, send its recording to the pre-recorded API for a
# speaker-labelled transcript and optionally summarise it. OFF by default:
# every finished call becomes a paid upload.
# NEURACALL_POST_CALL=1

# LLM Gateway model for the summary. No default on purpose — the ids are exact
# versioned strings that change often. Without it, calls are transcribed
# post-hoc but not summarised.
# NEURACALL_SUMMARY_MODEL=claude-sonnet-4-6
