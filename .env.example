# NeuraCall local environment (GITIGNORED — do not commit)
ASSEMBLYAI_API_KEY=replace-me
ASSEMBLYAI_REGION=us
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
# --- Optional realtime STT fine-tuning (U3.5 Pro) --------------------------
# Steer recognition toward these languages ("en,fr,ar"). Empty = auto-detect,
# which is right for a mix of Arabic and French.
ASSEMBLYAI_LANGUAGE_CODES=
# VAD confidence threshold 0-1 (e.g. 0.6 = stricter word gate than default).
ASSEMBLYAI_VAD_THRESHOLD=
# Turn endpointing: ms of silence that nudges an end-of-turn check (50-10000),
# and the ceiling beyond which the turn is forced to end.
ASSEMBLYAI_MIN_TURN_SILENCE=
ASSEMBLYAI_MAX_TURN_SILENCE=
# Emit Heartbeat every 5 s (nice-to-have liveness signal for monitoring).
ASSEMBLYAI_SESSION_HEARTBEAT=

# --- OpenAI-compatible LLM (also backs the default TTS on the composed path) --
# With no TTS_* set, selectTtsClient defaults to POST /v1/audio/speech on this
# same endpoint/key, so the LLM model should be TTS-capable there (e.g.
# openai/gpt-4o-mini-tts on OpenRouter) or you should set TTS_MODEL. LLM_BASE_URL
# is optional; the LLM and the default TTS share whichever root you put here.
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_BASE_URL=

# TTS overrides the LLM-backed default when set (key, model and optionally
# TTS_PROVIDER / TTS_BASE_URL / TTS_VOICE).
TTS_API_KEY=replace-me
TTS_MODEL=replace-me

WHATSAPP_TOKEN=

# --- AssemblyAI Voice Agent -------------------------------------------------
# One socket does speech-to-text, the reply and the voice, on the ASSEMBLYAI_API_KEY
# above — so no LLM or TTS credential is needed. This is what makes the LLM and
# TTS placeholders below irrelevant rather than merely unset.
VOICE_AGENT_ENABLED=
# "estelle" speaks French, which suits Algerian callers; the agent UNDERSTANDS
# Arabic and Darija but cannot speak them. Change it in Settings → Voice Agent
# (alba/eve/george/jane/jean/mary/michael = US English, anna/charles/paul/vera =
# UK English, giovanni=it, lola=es, juergen=de, rafael=pt, estelle=fr).
VOICE_AGENT_VOICE=
VOICE_AGENT_GREETING=
VOICE_AGENT_SYSTEM_PROMPT=
