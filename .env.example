# ============================================================================
# NeuraCall environment reference (COMMITTED — placeholders only)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ============================================================================

# --- AssemblyAI (Speech-to-Text) ---
# Create/rotate a key at https://www.assemblyai.com/dashboard/api-keys
# This is the raw key — no "Bearer" prefix. Keep it server-side only.
ASSEMBLYAI_API_KEY=replace-me

# Region / data residency: "us" or "eu"
#   us -> api.assemblyai.com / streaming.assemblyai.com
#   eu -> api.eu.assemblyai.com / streaming.eu.assemblyai.com
ASSEMBLYAI_REGION=us

# Optional: AssemblyAI realtime speech model (defaults to universal-3-5-pro).
# Realtime uses the SINGULAR string; pre-recorded uses a plural array.
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# --- AI agent brain (LLM for replies) ---
# e.g. OpenRouter / Anthropic / OpenAI. Configure whichever the agent uses.
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# --- TTS provider ---
# e.g. ElevenLabs / OpenAI / Play.ht
TTS_API_KEY=replace-me
TTS_MODEL=replace-me

# --- WhatsApp (optional) ---
# WhatsApp Cloud API or bridge credentials
WHATSAPP_TOKEN=replace-me
