{
  "name": "@neuracall/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neuracall/aai-client": "*",
    "@neuracall/config": "*",
    "@neuracall/device-manager": "*",
    "@neuracall/scrcpy-bridge": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
